{
  "name": "ricr-testing-assignment",
  "version": "1.0.0",
  "private": true,
  "description": "Reference solution for the RICR QA evaluation task",
  "scripts": {
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand src/tests",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test e2e/auth.api.spec.ts",
    "test:e2e:ui": "playwright test e2e/login.ui.spec.ts e2e/login.pom.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "jest --runInBand src/tests && playwright test",
    "mock:server": "node mock-server.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "express": "^5.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.0"
  }
}
